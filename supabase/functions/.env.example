# Server secrets for the Edge Functions. Set them on the hosted project with:
#   npx supabase secrets set --env-file supabase/functions/.env
# Never commit the real file.

# AI provider: "gemini" (has a free tier) or "anthropic" (Claude)
AI_PROVIDER=gemini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Live video (LiveKit Cloud → Settings → Keys)
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
